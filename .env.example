# === Obligatoire ===
# Token du bot obtenu via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Ta cle API Anthropic (pour /rapport et /signal)
ANTHROPIC_API_KEY=sk-ant-...

# Ton chat_id Telegram (envoie /start au bot pour le connaitre).
# IMPORTANT : sans cette variable, toutes les commandes sensibles sont bloquees.
AUTHORIZED_CHAT_IDS=123456789

# URL PUBLIQUE du manifest TON Connect. Defaut (deja en ligne, rien a faire) :
# https://sozo19.github.io/tonconnect-manifest.json
# Ne remplir que pour utiliser un autre hebergement.
TONCONNECT_MANIFEST_URL=https://sozo19.github.io/tonconnect-manifest.json

# === Optionnel ===
# Cle API toncenter.com (gratuite via @tonapibot) — evite les limites de debit
TONCENTER_API_KEY=

# Si le bot est utilise dans un GROUPE : user_ids autorises a trader (obligatoire
# en groupe, sinon tout membre du groupe pourrait utiliser le bot).
AUTHORIZED_USER_IDS=

# Repertoire des sessions TON Connect (defaut : .tc_sessions)
TC_SESSIONS_DIR=

# Plafonds de securite par swap
MAX_SWAP_TON=25
MAX_SWAP_USDT=50

# Tolerance de slippage en points de base (100 = 1%)
SLIPPAGE_BPS=100

# Modele Claude pour /signal (claude-opus-5 par defaut ; claude-sonnet-5 = moins cher)
CLAUDE_MODEL=claude-opus-5

# Mettre a 1 pour utiliser le testnet TON. Attention : ne concerne que la
# connexion du wallet et la lecture des soldes — les swaps STON.fi sont
# refuses en testnet (pas de paire TON/USDT equivalente).
TON_TESTNET=
